<!DOCTYPE html>
<html lang="fr">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Catalogue d'Ouvrages</title>
</head>
<body>	
	<h1>Liste des ouvrages</h1>
	<form method="GET" action="/liste">
		<input type="text" name="titre" value="<%= titre || '' %>" placeholder="Rechercher un ouvrage...">
		<button type="submit">Rechercher</button>
		<details <% if ( auteur || anneeMin !== null || anneeMax !== null) { %> open <% } %>>
			<summary>Recherche avancée</summary>
			<div>
				<label for="auteur">Auteur:</label>
				<input type="text" id="auteur" name="auteur" value="<%= auteur || '' %>">
			</div>
			<div>
				<label for="anneeMin">Année de publication:</label>
				<input type="number" id="anneeMin" placeholder="De" name="anneeMin" value="<%= anneeMin ?? '' %>">
				<input type="number" id="anneeMax" placeholder="À" name="anneeMax" value="<%= anneeMax ?? '' %>">
			</div>
		</details>
	</form>

	<a href="/ajouter">Ajouter un ouvrage</a>

	<% if (ouvrages.length === 0) { %>
		<p>Aucun ouvrage trouvé.</p>
	<% } %>

	<ul>
		<% ouvrages.forEach(ouvrage => { %>
			<li><a href="/fiche/<%= ouvrage.id %>"><%= ouvrage.titre %> - <%= ouvrage.auteur %></a></li>
		<% }) %>
	</ul>

</body>
</html>