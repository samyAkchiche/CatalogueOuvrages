<!DOCTYPE html>
<html lang="fr">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Catalogue d'Ouvrages</title>
</head>
<body>	
	<h1>Liste des ouvrages</h1>
	<form method="GET" action="/liste">
		<input type="text" name="titre" value="<%= query.titre || '' %>" placeholder="Rechercher un ouvrage...">
		<button type="submit">Rechercher</button>
	</form>

	<% if (ouvrages.length === 0) { %>
		<p>Aucun ouvrage trouvé.</p>
	<% } %>

	<ul>
		<% ouvrages.forEach(ouvrage => { %>
			<li><%= ouvrage.titre %> - <%= ouvrage.auteur %></li>
		<% }) %>
	</ul>

</body>
</html>